# =============================================================================
# CloudPulse AI — .gitignore
# =============================================================================

# Environment
.env
.env.local
.env.*.local

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
*.tsbuildinfo

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
backend/.venv/
backend/venv/
backend/.env
backend/__pycache__/
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Docker
docker/volumes/

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# ChromaDB local data
chroma_data/
chroma_db_data/
backend/chroma_db_data/

# Alembic
backend/alembic/versions/*.pyc
