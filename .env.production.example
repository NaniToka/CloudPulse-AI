# =============================================================================
# CloudPulse AI — Production Environment Template
# Copy this file to .env.production on production servers.
# =============================================================================

APP_ENV=production
APP_NAME="CloudPulse AI"
APP_VERSION=1.0.0
DEMO_MODE=false

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=false

VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="CloudPulse AI"
VITE_APP_ENV=production

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cloudpulse_prod_db
POSTGRES_USER=cloudpulse_prod_admin
POSTGRES_PASSWORD=use_strong_unique_postgres_password
DATABASE_URL=postgresql+asyncpg://cloudpulse_prod_admin:use_strong_unique_postgres_password@postgres:5432/cloudpulse_prod_db

# Production 32+ byte secret keys
SECRET_KEY=generate_with_openssl_rand_hex_32_for_production
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32_for_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Restrict to exact frontend domain in production
CORS_ORIGINS=https://app.cloudpulse.io,https://cloudpulse.io

REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=cloudpulse_vectors

# Production AI Keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TEMPERATURE=0.7

LOG_LEVEL=INFO
LOG_FORMAT=json
