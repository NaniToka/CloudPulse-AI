# =============================================================================
# CloudPulse AI — Environment Configuration Template
# Copy this file to .env for local development or Docker Compose.
# NEVER commit real passwords or private API keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
APP_ENV=development          # development | demo | production
APP_NAME="CloudPulse AI"
APP_VERSION=1.0.0
DEMO_MODE=true               # Enables deterministic synthetic telemetry & RCA when offline

# -----------------------------------------------------------------------------
# Backend API (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=false

# -----------------------------------------------------------------------------
# Frontend (React + Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="CloudPulse AI"
VITE_APP_ENV=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cloudpulse
POSTGRES_USER=cloudpulse_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://cloudpulse_user:change_me_in_production@postgres:5432/cloudpulse

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_32_byte_hex_string
JWT_SECRET_KEY=change_this_to_a_secure_random_32_byte_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS Configuration (Restricted domains in production)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost

# -----------------------------------------------------------------------------
# Redis (Caching & Task Queues)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# ChromaDB (Vector Search Database)
# -----------------------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=cloudpulse_vectors

# -----------------------------------------------------------------------------
# AI Services (Optional - Falls back to local deterministic SRE engine if unset)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Observability & Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
